{
  "name": "peron",
  "version": "1.0.0",
  "description": "Train delay statistics for Finland's rail network, built on the official open Digitraffic feed: punctuality, delay causes, worst trains, station map and a live board.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts public",
    "lint:fix": "biome check --write src tests scripts public",
    "test": "vitest run",
    "backfill": "tsx --env-file-if-exists=.env scripts/backfill.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@sinclair/typebox": "^0.34.52",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
